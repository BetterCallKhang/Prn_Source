<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PRN232</title>
    <!-- Bootstrap qua CDN: đúng 1 dòng, không theme -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-page="/Index">PRN232 Exam</a>
            <ul class="navbar-nav me-auto">
                @if (Context.Session.GetString("accessToken") != null)
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Products/Index">Products</a>
                    </li>
                }
            </ul>
            <ul class="navbar-nav">
                @if (Context.Session.GetString("accessToken") != null)
                {
                    <li class="nav-item">
                        <span class="navbar-text me-3">
                            @Context.Session.GetString("username")
                            (@Context.Session.GetString("role"))
                        </span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Logout">Logout</a>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Login">Login</a>
                    </li>
                }
            </ul>
        </div>
    </nav>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
