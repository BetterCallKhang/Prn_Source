@page "{id:int}"
@model Prn232.Fe.Pages.Products.DeleteModel
@{
    ViewData["Title"] = "Xoá sản phẩm";
}

<h2>Xoá sản phẩm</h2>

@if (Model.Product == null)
{
    <div class="alert alert-warning">Không tìm thấy sản phẩm.</div>
    <a class="btn btn-secondary" asp-page="./Index">Quay lại</a>
}
else
{
    <div class="alert alert-danger">Bạn có chắc muốn xoá sản phẩm này?</div>

    <dl class="row">
        <dt class="col-sm-2">Id</dt>
        <dd class="col-sm-10">@Model.Product.Id</dd>

        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Product.Name</dd>

        <dt class="col-sm-2">Price</dt>
        <dd class="col-sm-10">@Model.Product.Price.ToString("N0")</dd>

        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Product.Description</dd>
    </dl>

    <form method="post">
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }
        <button type="submit" class="btn btn-danger">Xoá</button>
        <a class="btn btn-secondary" asp-page="./Index">Huỷ</a>
    </form>
}
